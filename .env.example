# ==============================================================================
# NexServe Root Environment Configuration Reference
# ==============================================================================

# Backend Service (.env placed in /backend)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nexserve
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
AI_SERVICE_URL=http://localhost:8000
ADMIN_EMAIL=admin@nexserve.local
ADMIN_PASSWORD=admin123
CORS_ORIGIN=http://localhost:5173

# Frontend Application (.env placed in /frontend)
VITE_API_URL=http://localhost:5000/api

# AI Service (.env placed in /ai-service)
PORT=8000
FLASK_DEBUG=0
